# Physika Modulo `%` Operation

# 1. As a standalone operation

print(10 % 2)
print(12 % 5)

# 2. As a operation between variables

a: ℝ = 10
b: ℝ = 4

print(a % b)

# 3. On a array of numbers

a: ℝ[4] = [10, 12, 15, 17]
b: ℝ = 4

print(a % b)

# 4. Both side being array of numbers

a: ℝ[4] = [10, 12, 15, 17]
b: ℝ[4] = [1, 3, 5, 7]
print(a % b)
