# =====================================================================
# Example file for Dictionary in Physika.
#
# * Basic declarations
# =====================================================================


# -----------------------------------------
# Basic declarations
# -----------------------------------------


empty_dict: Dict[ℝ, ℝ] = {}
print(empty_dict)


simple_dict: Dict[ℝ, ℝ] = {
    0: 1.6,
    1: 3.2,
    2: 5.5
}
print(simple_dict)


union_dict: Dict[ℝ, ℝ | ℂ | ℝ[3]] = {
    0: 1,
    1: 3j,
    2: 30,
    3: [1, 2, 3]
}
print(union_dict)
