# -----------------------
# Real type (ℝ)
# notations: ℝ  \mathbb{R}  \R  R
# -----------------------
r_unicode : ℝ = 3.14
r_mathbb : \mathbb{R} = 2.5
r_macro : \R = 1.5
r_ascii : R = 0.5

print(r_unicode)
print(r_mathbb)
print(r_macro)
print(r_ascii)

r_vector : ℝ[3] = [1.0, 2.0, 3.0]
r_matrix : ℝ[2, 2] = [[1.0, 2.0], [3.0, 4.0]]

print(r_vector)
print(r_matrix)


# -----------------------
# Integer type (ℤ)
# notations: ℤ  \mathbb{Z}  \Z  Z
# -----------------------
z_unicode : ℤ = 10
z_mathbb : \mathbb{Z} = -4
z_macro : \Z = 7
z_ascii : Z = 42

print(z_unicode)
print(z_mathbb)
print(z_macro)
print(z_ascii)

z_vector : ℤ[3] = [1, 2, 3]
print(z_vector)


# -----------------------
# Natural type (ℕ)
# notations: ℕ  \mathbb{N}  \N  N
# -----------------------
n_unicode : ℕ = 5
n_mathbb : \mathbb{N} = 8
n_macro : \N = 3
n_ascii : N = 1

print(n_unicode)
print(n_mathbb)
print(n_macro)
print(n_ascii)

n_vector : ℕ[4] = [0, 1, 2, 3]
print(n_vector)


# -----------------------
# Complex type (ℂ)
# notations: ℂ  \mathbb{C}
# -----------------------
c_unicode : ℂ = 3 + 1j
c_mathbb : \mathbb{C} = 5 + 3j

print(c_unicode)
print(c_mathbb)

c_vector : ℂ[2] = [1 + 2j, 3 + 4j]
print(c_vector)



# -----------------------
# string type (String)
# notations: String
# -----------------------

name: String = "physika"
print(name)
