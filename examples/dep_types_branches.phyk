# Examples of dependent types read from inside an if branch

A: ℝ[3, 2] = [[2, 1], [7, 6], [4, 5]]
B: ℝ[3, 2] = [[2, 1], [7, 6], [4, 5]]
C: ℝ[2, 2] = [[2, 1], [7, 6]]

# Example #1
# Two matrices have the same order when both of their dimensions match.
# `a`, `b`, `m` and `n` are bound by the parameter types, so the conditions
# read them without a `shape()` or similar function. The `return` sits inside
# a nested if.
def is_same_order(u : ℝ[a, b], v : ℝ[m, n]): ℕ:
    if a == m:
        if b == n:
            return 1
        else:
            return 0
    return 0

is_same_order(A, B)
is_same_order(A, C)

# Example #2
# Same check, written by accumulating one flag per dimension and returning
# from an if/else instead.
def is_same_order2(u : ℝ[a, b], v : ℝ[m, n]): ℕ:
    o1: ℕ = 0
    o2: ℕ = 0
    if a == m:
        o1 = 1
    if b == n:
        o2 = 1
    if (o1 + o2) == 2:
        return 1
    else:
        return 0

is_same_order2(A, B)
is_same_order2(A, C)
