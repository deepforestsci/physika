# =====================================================================
# Nodal analysis of a resistive circuit
#
# Nodes are numbered 1..num_nodes, node 0 is ground.
# Each resistor row is       [node1, node2, resistance]
# Each current source row is [node1, node2, current], current flows node1 -> node2
#
# Builds the conductance matrix G and the current vector I, then solves
# G V = I with Gaussian elimination (partial pivoting).
# =====================================================================

def zeros_1d(n: ℕ): ℝ[n]:
    return for i: ℕ(n) -> i * 0.0

def zeros_2d(n: ℕ): ℝ[n, n]:
    return for i: ℕ(n) -> for j: ℕ(n) -> i * 0.0

# Conductance matrix
def conductance_matrix(num_nodes: ℕ, resistors: ℝ[k, 3], num_resistors: ℕ): ℝ[num_nodes, num_nodes]:
    G: ℝ[num_nodes, num_nodes] = zeros_2d(num_nodes)
    n1: ℝ = 0.0
    n2: ℝ = 0.0
    g: ℝ = 0.0
    for r: ℕ(num_resistors):
        n1 = resistors[r, 0]
        n2 = resistors[r, 1]
        g = 1.0 / resistors[r, 2]
        if n1 != 0.0:
            G[n1 - 1, n1 - 1] += g
        if n2 != 0.0:
            G[n2 - 1, n2 - 1] += g
        # both nodes are non-ground
        if n1 != 0.0:
            if n2 != 0.0:
                G[n1 - 1, n2 - 1] = G[n1 - 1, n2 - 1] - g
                G[n2 - 1, n1 - 1] = G[n2 - 1, n1 - 1] - g
    return G

# Current vector
def current_vector(num_nodes: ℕ, sources: ℝ[k, 3], num_sources: ℕ): ℝ[num_nodes]:
    I: ℝ[num_nodes] = zeros_1d(num_nodes)
    n1: ℝ = 0.0
    n2: ℝ = 0.0
    current: ℝ = 0.0
    for s: ℕ(num_sources):
        n1 = sources[s, 0]
        n2 = sources[s, 1]
        current = sources[s, 2]
        # current leaves n1
        if n1 != 0.0:
            I[n1 - 1] = I[n1 - 1] - current
        # current enters n2
        if n2 != 0.0:
            I[n2 - 1] += current
    return I

def eye(n: ℕ): ℝ[n, n]:
    E: ℝ[n, n] = zeros_2d(n)
    for i: ℕ(n):
        E[i, i] = 1.0
    return E

# Solve A x = b by Gauss-Jordan elimination.
# Every step builds a new A and b instead of updating them in place, so
# autograd can differentiate the solution with respect to A and b.
# No pivoting: a conductance matrix of a grounded circuit is symmetric
# positive definite, so the pivots A[c, c] never vanish.
def linear_solve(n: ℕ, A: ℝ[n, n], b: ℝ[n]): ℝ[n]:
    E: ℝ[n, n] = eye(n)
    for c: ℕ(n):
        b = for i: ℕ(n) -> b[i] - (A[i, c] - E[i, c]) * b[c] / A[c, c]
        A = for i: ℕ(n) -> for j: ℕ(n) -> A[i, j] - (A[i, c] - E[i, c]) * A[c, j] / A[c, c]
    return b

def nodal_analysis(num_nodes: ℕ, resistors: ℝ[k, 3], num_resistors: ℕ, sources: ℝ[m, 3], num_sources: ℕ): ℝ[num_nodes]:
    G: ℝ[num_nodes, num_nodes] = conductance_matrix(num_nodes, resistors, num_resistors)
    I: ℝ[num_nodes] = current_vector(num_nodes, sources, num_sources)
    return linear_solve(num_nodes, G, I)


resistors: ℝ[3, 3] = [
    [1, 2, 1000],
    [1, 0, 1000],
    [2, 0, 1000]
]

# 1 mA from ground -> node 1, 1 mA from ground -> node 2
current_sources: ℝ[2, 3] = [
    [0, 1, 0.001],
    [0, 2, 0.001]
]

voltages: ℝ[2] = nodal_analysis(2, resistors, 3, current_sources, 2)
voltages


# =====================================================================
# Differentiable circuit analysis
# =====================================================================

# V1 of the circuit above as a function of its three resistances
def v1_of(Rs: ℝ[3]): ℝ:
    res: ℝ[3, 3] = [
        [1, 2, Rs[0]],
        [1, 0, Rs[1]],
        [2, 0, Rs[2]]
    ]
    v: ℝ[2] = nodal_analysis(2, res, 3, current_sources, 2)
    return v[0]

Rs: ℝ[3] = [1000.0, 1000.0, 1000.0]

# Sensitivities dV1/dR_k, in volts per ohm
sensitivities: ℝ[3] = grad(v1_of(Rs), Rs)
sensitivities

# ---------------------------------------------------------------------
# Design: choose the node 2 -> ground resistor R3 so that V1 = 1.2 V.
# Newton's method, with dV1/dR3 computed by autodiff through the solver.
# ---------------------------------------------------------------------

target: ℝ = 1.2

def v1_of_r3(R3: ℝ): ℝ:
    res: ℝ[3, 3] = [
        [1, 2, 1000.0],
        [1, 0, 1000.0],
        [2, 0, R3]
    ]
    v: ℝ[2] = nodal_analysis(2, res, 3, current_sources, 2)
    return v[0]

R3: ℝ = 1000.0
for it: ℕ(6):
    R3 = R3 - (v1_of_r3(R3) - target) / grad(v1_of_r3(R3), R3)

R3
v1_of_r3(R3)
