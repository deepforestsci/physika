# ----------------------------------------------
# Import from Std
# ----------------------------------------------

from Std.linear_solvers import gaussian_solve, get_2d_array_num_cols, get_2d_array_num_rows, get_1d_array_length, zero_2d_array, zero_1d_array

A: ℝ[3,3] = [
    [1, 2, 1],
    [3, 1, -1],
    [2, -1, 1]
]
b: ℝ[3] = [8, 2, 3]

gaussian_results: ℝ[3] = gaussian_solve(A, b)
gaussian_results
