# ============================================================
# Parameter Learning for the Selkov Glycolytic Oscillator
# ============================================================
# Glycolysis can oscillate: in yeast the concentrations of the
# glycolytic intermediates rise and fall in a sustained rhythm,
# driven by the allosteric enzyme phosphofructokinase (PFK),
# whose product activates it (positive feedback). The Selkov
# model (Sel'kov, 1968) is the classic two-variable caricature
# of this, in dimensionless form:
#
#   dx/dt = a*y + x^2*y - x        (x ~ ADP, the activator)
#   dy/dt = b - a*y - x^2*y        (y ~ F6P, the substrate)
#
# The x^2*y term is the allosteric feedback (Hill cooperativity
# of 2): the product x activates its own production. Substrate
# is supplied at rate b. We learn theta = [a, b]. For a = 0.1,
# b = 0.6 the steady state is unstable and the system settles
# onto a LIMIT CYCLE -- a sustained oscillation.
#
# Same adjoint machinery as the sibling tutorials (full-
# trajectory MSE + running-cost co-state). As in the SIR
# tutorial, the observation is PARTIAL: an experiment tracks a
# single metabolite (here x), so we fit the x(t) curve ALONE --
# the co-state residual lives only on the x component. Because
# the oscillation is periodic, one measured curve re-samples the
# same dynamics every cycle, and its frequency, amplitude and
# shape are enough to pin down both kinetic parameters.
# ============================================================

def zero_1d_array(len: ℝ): ℝ[m]:
    results: ℝ[len] = for i: ℕ(len) -> i*0
    return results

def get_1d_array_length(x: ℝ[m]): ℝ:
    total: ℝ = 0
    temp: ℝ = 0
    for i:
        temp = x[i]
        total += 1
    return total

def append(x: ℝ[m], var: ℝ): ℝ[n]:
    new_length: ℝ = len(x) + 1
    results: ℝ[new_length] = zero_1d_array(new_length)
    len_x: ℕ = get_1d_array_length(x)
    for i:ℕ(new_length):
        if i<len_x:
            results[i] = x[i]
        else:
            results[i] = var
    return results

def f(state: ℝ[2], θ: ℝ[2]): ℝ[2]:
    x: ℝ = state[0]
    y: ℝ = state[1]
    a: ℝ = θ[0]
    b: ℝ = θ[1]
    dx: ℝ = a * y + x ** 2 * y - x
    dy: ℝ = b - a * y - x ** 2 * y
    return [dx, dy]

def rk4_step(state: ℝ[2], θ: ℝ[2]): ℝ[2]:
    k1: ℝ[2] = f(state, θ)
    k2_state: ℝ[2] = state + 0.5 * dt * k1
    k2: ℝ[2] = f(k2_state, θ)
    k3_state: ℝ[2] = state + 0.5 * dt * k2
    k3: ℝ[2] = f(k3_state, θ)
    k4_state: ℝ[2] = state + dt * k3
    k4: ℝ[2] = f(k4_state, θ)
    return state + (dt / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)

dt: ℝ = 0.05
timesteps: ℝ = 600

def solver(θ: ℝ[2]): ℝ[2, m]:
    state: ℝ[2] = [1.0, 1.0]
    x_array: ℝ[1] = [1.0]
    y_array: ℝ[1] = [1.0]
    for i:ℕ(timesteps):
        results = rk4_step(state, θ)
        x = results[0]
        y = results[1]
        x_array = append(x_array, x)
        y_array = append(y_array, y)
        state = results
    return [x_array, y_array]

true_theta: ℝ[2] = [0.1, 0.6]
true_results: ℝ[2, m] = solver(true_theta)
true_x: ℝ[m] = true_results[0]
true_y: ℝ[m] = true_results[1]

# Only the metabolite x(t) is observed, so the loss and its
# co-state residual live on the x component alone (y -> 0.0).
def adjoint_grad(θ: ℝ[2]): ℝ[n]:
    states: ℝ[2, m] = solver(θ)
    x_array: ℝ[m] = states[0]
    y_array: ℝ[m] = states[1]
    m: ℝ = get_1d_array_length(x_array)
    s: ℝ[2] = [
        (x_array[m-1] - true_x[m-1]) / m,
        0.0
    ]
    L: ℝ[2] = zero_1d_array(2)
    for i:ℕ(m-1):
        idx = m - 2 - i
        x = x_array[idx]
        y = y_array[idx]
        state = [x, y]
        J_state = grad(rk4_step(state, θ), state)
        J_theta = grad(rk4_step(state, θ), θ)
        L += s @ J_theta
        residual = [(x_array[idx] - true_x[idx]) / m, 0.0]
        s = residual + (s @ J_state)
    return L

θ: ℝ[2] = [0.2, 0.45]
learning_rate: ℝ = 0.01
beta1: ℝ = 0.9
beta2: ℝ = 0.999
eps_adam: ℝ = 0.00000001
m_adam: ℝ[2] = [0.0, 0.0]
v_adam: ℝ[2] = [0.0, 0.0]
t_adam: ℝ = 0.0

# ------------------------------------------------------------------
# set epochs higher (e.g. 3000) for real training; here it is 1 so
# physika's test suite (tests/test_tutorials.py) runs quickly
# ------------------------------------------------------------------
epochs: ℕ = 1

for i:ℕ(epochs):
    g = adjoint_grad(θ)
    t_adam = t_adam + 1.0
    m_adam = beta1 * m_adam + (1.0 - beta1) * g
    v_adam = beta2 * v_adam + (1.0 - beta2) * (g * g)
    mhat = m_adam / (1.0 - beta1 ** t_adam)
    vhat = v_adam / (1.0 - beta2 ** t_adam)
    θ = θ - learning_rate * mhat / (sqrt(vhat) + eps_adam)

pred_results = solver(θ)
#plot_trajectories(true_results, pred_results)
