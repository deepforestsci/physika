# ─────────────────────────────────────────────────────────────────────
#  Differentiable nodal analysis of a resistive network
#
#    Node 0 is ground; nodes 1, …, n carry the unknown potentials V.
#    Resistor k joins the nodes e_k = (a_k, b_k), with resistance r_k.
#    Source   s drives the current J_s from a_s to b_s.
#
#        A(e, p) = δ(a, p) − δ(b, p)                    incidence
#        G[p, q] = Σ_k A(e_k, p) A(e_k, q) / r_k        conductance
#        I[p]    = −Σ_s A(e_s, p) J_s                   injected current
#        G V     = I                                    Kirchhoff's law
# ─────────────────────────────────────────────────────────────────────

def δ(x: ℝ, y: ℝ): ℝ:
    if x == y:
        return 1.0
    else:
        return 0.0

# +1 if branch e leaves node p, −1 if it enters p
def A(e: ℝ[2], p: ℝ): ℝ:
    return δ(e[0], p) - δ(e[1], p)

# Gauss–Jordan elimination  (G is SPD: no pivoting)
def gauss_jordan(n: ℕ, ν: ℝ[n],
                 G: ℝ[n, n], I: ℝ[n]): ℝ[n]:
    for c: ℕ(n):
        f: ℝ[n] = for p: ℕ(n) → (
            (G[p, c] - δ(ν[p], ν[c])) / G[c, c])
        I = for p: ℕ(n) → I[p] - f[p] * I[c]
        G = for p: ℕ(n) → for q: ℕ(n) → (
            G[p, q] - f[p] * G[c, q])
    return I

# ν: node labels,  E, r: resistor branches and values,
# S, J: source branches and currents
def nodal_analysis(n: ℕ, ν: ℝ[n],
                   m: ℕ, E: ℝ[m, 2], r: ℝ[m],
                   s: ℕ, S: ℝ[s, 2], J: ℝ[s]): ℝ[n]:
    G: ℝ[n, n] = for p: ℕ(n) → for q: ℕ(n) → sum(
        for k: ℕ(m) → A(E[k], ν[p]) * A(E[k], ν[q]) / r[k])
    I: ℝ[n] = for p: ℕ(n) → 0.0 - sum(
        for k: ℕ(s) → A(S[k], ν[p]) * J[k])
    return gauss_jordan(n, ν, G, I)


# ── Example: two nodes, three resistors, two sources ─────────────────
#
#          1 mA ↑          1 kΩ          ↑ 1 mA
#               ①──────────/\/\/──────────②
#               │                         │
#              1 kΩ                      1 kΩ
#               │                         │
#               ⏚                         ⏚

nodes: ℝ[2] = [1, 2]

resistors: ℝ[3, 2] = [[1, 2], [1, 0], [2, 0]]
r: ℝ[3] = [1000.0, 1000.0, 1000.0]                     # Ω

sources: ℝ[2, 2] = [[0, 1], [0, 2]]
J: ℝ[2] = [0.001, 0.001]                               # A

V: ℝ[2] = nodal_analysis(2, nodes, 3, resistors, r, 2, sources, J)
V


# ── Sensitivity ∂V₁/∂r by autodiff through the solver ────────────────

def V1(r: ℝ[3]): ℝ:
    V: ℝ[2] = nodal_analysis(2, nodes, 3, resistors, r, 2, sources, J)
    return V[0]

dV1_dr: ℝ[3] = grad(V1(r), r)
dV1_dr


# ── Design: choose r₃ so that V₁ = 1.2 V, by Newton's method ─────────

def V1_of_r3(r3: ℝ): ℝ:
    rk: ℝ[3] = [1000.0, 1000.0, 0.0]
    rk[2] = r3
    return V1(rk)

r3: ℝ = 1000.0
for it: ℕ(6):
    r3 = r3 - (V1_of_r3(r3) - 1.2) / grad(V1_of_r3(r3), r3)

r3
V1_of_r3(r3)
