physika.seed(0)
from lbfgs import LBFGS, pushrow
π: ℝ = 3.14159265

def tanh(a: ℝ[p,q]): ℝ[p,q]:
    num: ℝ[p,q] = exp(a) - exp(-a)
    denom: ℝ[p,q] = exp(a) + exp(-a)
    return num / denom

def mat(θ: ℝ[p], off: ℕ, r: ℕ, c: ℕ): ℝ[r,c]:
    return for i:ℕ(r) -> θ[off + i*c : off + (i+1)*c]

def row(θ: ℝ[p], off: ℕ, L: ℕ): ℝ[1,L]:
    return [θ[off:off+L]]

def squeeze(W1: ℝ[2,H], b1: ℝ[1,H], W2: ℝ[H,1], b2: ℝ[1,1], H: ℕ, n: ℕ): ℝ[n]:
    v: ℝ[n] = for i:ℕ(n) -> i*0
    v[0:H] = W1[0]
    v[H:2*H] = W1[1]
    v[2*H:3*H] = b1[0]
    v[3*H:4*H] = W2[:,0]
    v[4*H:4*H+1] = b2[0]
    return v

def linear(x: ℝ[1,li], W: ℝ[li,lo], b: ℝ[1,lo]): ℝ[1,lo]:
    return x @ W + b

def rand2d(ra: ℝ, rb: ℝ, σ: ℝ): ℝ[ra,rb]:
    return for i:ℕ(ra) -> ε: ℝ[rb] ~ Normal(0.0, σ, rb)

def zeros2d(za: ℝ, zb: ℝ): ℝ[za,zb]:
    return for i:ℕ(za) -> for j:ℕ(zb) -> j*0.0

class Net(H: ℕ):
    def apply(θ: ℝ[n], t: ℝ, x: ℝ) -> ℝ:
        h = this.H
        wt: ℝ[1,H] = [θ[0 : h]]
        wx: ℝ[1,H] = [θ[h : 2*h]]
        b1: ℝ[1,H] = [θ[2*h : 3*h]]
        w2: ℝ[H] = θ[3*h : 4*h]
        hid: ℝ[1,H] = tanh(t * wt + x * wx + b1)
        out: ℝ = sum(hid[0] * w2) + θ[4*h]
        return out

def Nu(u: ℝ, u_x: ℝ, u_xx: ℝ): ℝ:
    return u * u_x - (0.01 / π) * u_xx

class PINN(net: Net, θ: ℝ[n], m: ℕ, n: ℕ):
    S: ℝ[m,n]
    Y: ℝ[m,n]
    θp: ℝ[n]
    gp: ℝ[n]
    step: ℝ
    def u(t: ℝ, x: ℝ): ℝ:
        return this.net.apply(this.θ, t, x)
    def f(t: ℝ, x: ℝ): ℝ:
        uu: ℝ = this.u(t, x)
        u_t: ℝ = grad(uu, t)
        u_x: ℝ = grad(uu, x)
        u_xx: ℝ = grad(u_x, x)
        return u_t + Nu(uu, u_x, u_xx)
    def λ(t: ℝ, x: ℝ) -> ℝ:
        return this.u(t, x)
    def predict(t: ℝ, Xg: ℝ[m]): ℝ[m]:
        out: ℝ[m] = for i:ℕ(this.m) -> i*0.0
        for i:ℕ(this.m):
            out[i] = this.u(t, Xg[i])
        return out
    def loss(Tu: ℝ[m], Xu: ℝ[m], Uu: ℝ[m], Tf: ℝ[m], Xf: ℝ[m]): ℝ:
        mse_u: ℝ, mse_f: ℝ = 0.0, 0.0
        for i:ℕ(this.m):
            r = this.u(Tu[i], Xu[i]) - Uu[i]
            mse_u += (r * r)/this.m
            fi = this.f(Tf[i], Xf[i])
            mse_f += (fi * fi)/this.m
        return mse_u + mse_f
    def update_params(lr: ℝ, learnable_grads: ℝ[1, n]):
        g: ℝ[n] = learnable_grads[0]
        θ: ℝ[n] = this.learnable_params[0]
        this.S = pushrow(this.S, θ - this.θp, this.m)
        this.Y = pushrow(this.Y, g - this.gp, this.m)
        opt: LBFGS = LBFGS(g, this.S, this.Y, this.step, this.m, this.n)
        d: ℝ[n] = opt.direction()
        this.θp = θ
        this.gp = g
        this.θ = θ + lr * d
        this.step = this.step + 1.0
    def train(Tu: ℝ[m], Xu: ℝ[m], Uu: ℝ[m], Tf: ℝ[m], Xf: ℝ[m], epochs: ℕ, lr: ℝ): ℝ[epochs]:
        this.S = zeros2d(this.m, this.n)
        this.Y = zeros2d(this.m, this.n)
        this.θp = for i:ℕ(this.n) -> i*0.0
        this.gp = for i:ℕ(this.n) -> i*0.0
        this.step = this.step * 0.0
        losses: ℝ[epochs] = for i:ℕ(epochs) -> i*0
        for epoch:ℕ(epochs):
            L = this.loss(Tu, Xu, Uu, Tf, Xf)
            learnable_grads = grad(L, this.learnable_params)
            this.update_params(lr, learnable_grads)
            epoch_loss = this.loss(Tu, Xu, Uu, Tf, Xf)
            losses[epoch] = epoch_loss
            print(epoch_loss)
        return losses

H: ℝ = 32
n: ℝ = 4*H + 1
m: ℕ = 10
lr: ℝ = 1.0
s1: ℝ = sqrt(2.0 / (2.0 + H))
s2: ℝ = sqrt(2.0 / (H + 1.0))
W1: ℝ[2,H] = rand2d(2, H, s1)
b1: ℝ[1,H] = zeros2d(1, H)
W2: ℝ[H,1] = rand2d(H, 1, s2)
b2: ℝ[1,1] = zeros2d(1, 1)
θ0: ℝ[n] = squeeze(W1, b1, W2, b2, H, n)
net: Net = Net(H)
pinn: PINN = PINN(net, θ0, m, n)
print(DEVICE)

Ni: ℝ = 6
Nb: ℝ = 2
Tu: ℝ[m] = zeros(m)
Xu: ℝ[m] = zeros(m)
Uu: ℝ[m] = zeros(m)
for j:ℕ(Ni):
    xj = -1.0 + 2.0 * j / (Ni - 1)
    Xu[j] = xj
    Uu[j] = -sin(π * xj)
for k:ℕ(Nb):
    tk = k / (Nb - 1)
    Tu[Ni + k] = tk
    Xu[Ni + k] = -1.0
    Tu[Ni + Nb + k] = tk
    Xu[Ni + Nb + k] = 1.0
Tf: ℝ[m] ~ 𝒰(0.0, 1.0, m)
Xf: ℝ[m] ~ 𝒰(-1.0, 1.0, m)

epochs: ℕ = 1
losses: ℝ[epochs] = pinn.train(Tu, Xu, Uu, Tf, Xf, epochs, lr)

Xg: ℝ[m] = zeros(m)
for i:ℕ(m):
    Xg[i] = -1.0 + 2.0 * i / (m - 1)
pred25: ℝ[m] = pinn.predict(0.25, Xg)
pred50: ℝ[m] = pinn.predict(0.50, Xg)
pred75: ℝ[m] = pinn.predict(0.75, Xg)
