train_dataset_len: ℝ = 1
test_dataset_len: ℝ = 1

train_X: ℝ[20, 28, 28] = rand_3d_array(20, 28, 28, 0.5)
train_y: ℝ[20] = rand_1d_array(20, 0.0)

test_X: ℝ[10, 28, 28] = rand_3d_array(10, 28, 28, 0.5)
test_y: ℝ[10] = rand_1d_array(10, 0.0)

# ----------------------------------------------------------



def cross_entropy(probs: ℝ[m], label: ℝ): ℝ:
    p: ℝ = probs[label]
    return -log(p)


epochs: ℕ = 1
lr: ℝ = 0.1


cnn_object.train(train_X, train_y, epochs, lr, train_dataset_len)



def argmax(iterable: R[m]): R:
    idx: ℝ = 0
    max_val: ℝ = iterable[0]
    len_iterable: ℝ = get_1d_array_length(iterable)
    for i:ℕ(1, len_iterable):
        if iterable[i] > max_val:
            max_val = iterable[i]
            idx = i
    return idx


correct: ℝ = 0
len_test_X: ℝ = len(test_X[0])
y_true: ℝ = 0

for i:ℕ(test_dataset_len):
    x: ℝ[28, 28] = test_X[i]
    y_true = test_y[i]
    y_pred = cnn_object(x)
    pred_class = argmax(y_pred)
    if pred_class == y_true:
        correct += 1
accuracy: ℝ = correct / len_test_X
print(accuracy)
