from tutorials.linear_solve_gaussian_elimination import gaussian_solve, get_2d_array_num_rows, get_2d_array_num_cols, get_1d_array_length

def reaction(s: ℝ[m], u: ℝ[m], rk: ℝ): ℝ[m]:
    return rk * s * s + u

def build_cn_B_mat(r: ℝ, m: ℕ): ℝ[m, m]:
    B: ℝ[m, m] = zeros(m, m)
    interior: ℝ = m - 2
    for i:ℕ(interior):
        B[i+1, i] = -r
        B[i+1, i+1] = 1.0 + 2.0 * r
        B[i+1, i+2] = -r
    last: ℝ = m - 1
    B[0, 0] = 1.0
    B[last, last] = 1.0
    return B

def build_cn_C_mat(r: ℝ, m: ℕ): ℝ[m, m]:
    C: ℝ[m, m] = zeros(m, m)
    interior: ℝ = m - 2
    for i:ℕ(interior):
        C[i+1, i] = r
        C[i+1, i+1] = 1.0 - 2.0 * r
        C[i+1, i+2] = r
    return C

# Full Crank-Nicolson reaction-diffusion solver, nonlinear step solved implicitly by Newton iteration
class Crank_Nicholson(U: ℝ[Ns, m], Y: ℝ[Ns, 2], S: ℝ[Ns], m: ℕ, nt: ℕ, Ns: ℕ, dt: ℝ, r: ℝ, rk: ℝ):
    B: ℝ[m, m]
    C: ℝ[m, m]
    def field(u: ℝ[m]): ℝ[nt, m]:
        sn: ℝ[m] = zeros(m)
        Φ: ℝ[nt, m] = zeros(nt, m)
        last: ℝ = this.m - 1
        steps: ℝ = this.nt - 1
        half: ℝ = this.dt * 0.5
        newton_iters: ℝ = 3
        for n:ℕ(steps):
            g: ℝ[m] = this.C @ sn + half * reaction(sn, u, this.rk)
            g[0] = 0.0
            g[last] = 0.0
            s: ℝ[m] = sn
            for it:ℕ(newton_iters):
                fnew: ℝ[m] = half * reaction(s, u, this.rk)
                fnew[0] = 0.0
                fnew[last] = 0.0
                res: ℝ[m] = this.B @ s - g - fnew
                Jf = grad(reaction(s, u, this.rk), s)
                Jf[0, 0] = 0.0
                Jf[last, last] = 0.0
                J: ℝ[m, m] = this.B - half * Jf
                negR: ℝ[m] = zeros(m) - res
                delta: ℝ[m] = gaussian_solve(J, negR)
                s = s + delta
            sn = s
            Φ[n + 1, :] = sn
        return Φ
    def fill(a: ℝ, u: ℝ[m], Φ: ℝ[nt, m], P: ℕ): ℝ:
        lU: ℝ[Ns, m] = this.U
        lY: ℝ[Ns, 2] = this.Y
        lS: ℝ[Ns] = this.S
        xs: ℝ[P] ~ Uniform(0.0, 1.0, P)
        ts: ℝ[P] ~ Uniform(0.0, 1.0, P)
        for j:ℕ(P):
            xc: ℝ = xs[j]
            tc: ℝ = ts[j]
            lU[a*P + j, :] = u
            lY[a*P + j, 0] = xc
            lY[a*P + j, 1] = tc
            lS[a*P + j] = Φ[tc * (this.nt - 1), xc * (this.m - 1)]
        this.U = lU
        this.Y = lY
        this.S = lS
        return 0.0
    def sample(us: ℝ[nu, m], nu: ℝ, P: ℕ): ℝ[Ns]:
        this.B = build_cn_B_mat(this.r, this.m)
        this.C = build_cn_C_mat(this.r, this.m)
        for a:ℕ(nu):
            u: ℝ[m] = us[a]
            Φ: ℝ[nt, m] = this.field(u)
            this.fill(a, u, Φ, P)
        return this.S


physika.seed(0)
m_demo: ℝ, nt_demo: ℝ = 20, 10
D_demo: ℝ, k_demo: ℝ = 0.01, 0.01
dx_demo: ℝ = 1.0 / (m_demo - 1)
dt_demo: ℝ = 1.0 / (nt_demo - 1)
r_demo: ℝ = D_demo * dt_demo / (2.0 * dx_demo**2)

nu_demo: ℝ = 1
P_demo: ℕ = 5
Ns_demo: ℝ = 5

U_demo: ℝ[Ns_demo, m_demo] = zeros(Ns_demo, m_demo)
Y_demo: ℝ[Ns_demo, 2] = zeros(Ns_demo, 2)
S_demo: ℝ[Ns_demo] = zeros(Ns_demo)

us_demo: ℝ[nu_demo, m_demo] = for i:ℕ(nu_demo) -> ε: ℝ[m_demo] ~ Normal(0.0, 1.0, m_demo)

cn_demo: Crank_Nicholson = Crank_Nicholson(U_demo, Y_demo, S_demo, m_demo, nt_demo, Ns_demo, dt_demo, r_demo, k_demo)
done: ℝ[Ns_demo] = cn_demo.sample(us_demo, nu_demo, P_demo)

Sres: ℝ[Ns_demo] = cn_demo.S
Yres: ℝ[Ns_demo, 2] = cn_demo.Y
print(Sres[0])
print(Sres[1])
print(Yres[0, 0])
