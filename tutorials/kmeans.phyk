# =============================================================================
# K-Means clustering (Lloyd's algorithm)
# =============================================================================
#   SEED   Seed for the random initial centroids. Change it to try different
#          initialisation -- K-Means only finds a *local* optimum, so some
#          seeds cluster the data more cleanly than others.
#   K      How many clusters to look for.
#   ITERS  An *upper bound* on the number of Lloyd sweeps. The loop detects
#          convergence on its own, once the labels stop changing, so raising
#          ITERS past that point does nothing. It matters only when the data is
#          hard enough that convergence needs many sweeps.
#
# The algorithm alternates two steps until the centroids stop moving:
#   1. assignment : Label every point by its nearest centroid,
#                   label_i = argmin_j || x_i - c_j ||^2
#   2. update     : Move every centroid to the mean of its points
# =====================================================================

SEED:  ℝ = 2
K:     ℝ = 2
DIM:   ℝ = 2
NPTS:  ℝ = 15
ITERS: ℕ = 50

physika.seed(SEED)

# Helper Functions
def absolute(a: ℝ[m]): ℝ[m]:
    return sqrt(a * a)

def get_sum_of_1d_array(x: ℝ[m]): ℝ:
    total: ℝ = 0
    for i:
        total += x[i]
    return total

# Squared Euclidean distanc
def sq_dist(a: ℝ[DIM], b: ℝ[DIM]): ℝ:
    acc: ℝ = 0.0
    for c:ℕ(DIM):
        acc += (a[c] - b[c]) * (a[c] - b[c])
    return acc

# Index of the smallest entry of a length-K vector.
def argmin_vec(v: ℝ[K]): ℝ:
    av: ℝ[K] = absolute(v)
    best_j: ℝ = 0.0
    best_v: ℝ = av[0]
    for j:ℕ(K):
        if av[j] < best_v:
            best_v = av[j]
            best_j = j
    return best_j

# assignment step for one point: distance to every centroid, then argmin
def assign_one(point: ℝ[DIM], C: ℝ[K, DIM]): ℝ:
    dists: ℝ[K] = for j:ℕ(K) -> sq_dist(point, C[j])
    return argmin_vec(dists)

def assign_labels(X: ℝ[NPTS, DIM], C: ℝ[K, DIM]): ℝ[NPTS]:
    return for i:ℕ(NPTS) -> assign_one(X[i], C)

# mean of the points whose label equals `target`; if that cluster is currently
# empty, keep the previous centroid `fallback`
def new_centroid(X: ℝ[NPTS, DIM], labels: ℝ[NPTS], target: ℝ, fallback: ℝ[DIM]): ℝ[DIM]:
    sums: ℝ[DIM] = for c:ℕ(DIM) -> c * 0.0
    cnt: ℝ = 0.0
    for i:ℕ(NPTS):
        if labels[i] == target:
            sums = sums + X[i]
            cnt += 1.0
    if cnt > 0.0:
        return sums / cnt
    else:
        return fallback

# Update step: recompute all K centroids
def update_centroids(X: ℝ[NPTS, DIM], labels: ℝ[NPTS], C_old: ℝ[K, DIM]): ℝ[K, DIM]:
    return for j:ℕ(K) -> new_centroid(X, labels, j, C_old[j])

def data_min(X: ℝ[NPTS, DIM]): ℝ[DIM]:
    m: ℝ[DIM] = X[0]
    for i:ℕ(NPTS):
        m = (m + X[i] - absolute(m - X[i])) * 0.5
    return m

def data_max(X: ℝ[NPTS, DIM]): ℝ[DIM]:
    m: ℝ[DIM] = X[0]
    for i:ℕ(NPTS):
        m = (m + X[i] + absolute(m - X[i])) * 0.5
    return m

# one random centroid, uniform inside the [lo, hi] box
def rand_centroid(lo: ℝ[DIM], hi: ℝ[DIM]): ℝ[DIM]:
    s: ℝ[DIM] ~ 𝒰(0.0, 1.0, DIM)
    return lo + s * (hi - lo)

# ------------------- Example dataset (NPTS x DIM) --------------------
X: ℝ[15, 2] = [
    [2.0, 2.2], [2.8, 2.9], [1.9, 3.1], [3.1, 2.0], [2.5, 2.6],
    [3.6, 3.1], [4.1, 2.7], [3.3, 3.4], [4.0, 3.6], [3.7, 2.9],
    [3.0, 4.0], [2.7, 3.9], [3.4, 4.2], [2.9, 3.5], [3.2, 3.7]
]

# ------------------------- Run Lloyd's algorithm ------------------
lo_box: ℝ[DIM] = data_min(X)
hi_box: ℝ[DIM] = data_max(X)
C: ℝ[K, DIM] = for j:ℕ(K) -> rand_centroid(lo_box, hi_box)

prev_labels:  ℝ[NPTS] = for i:ℕ(NPTS) -> i * 0.0 - 1.0
labels:       ℝ[NPTS] = for i:ℕ(NPTS) -> i * 0.0
converged_at: ℝ = 0.0 - 1.0

for step:ℕ(ITERS):
    labels = assign_labels(X, C)
    moved = get_sum_of_1d_array(absolute(labels - prev_labels))
    if moved == 0.0:
        if converged_at < 0.0:
            converged_at = step
    else:
        C = update_centroids(X, labels, C)
    prev_labels = labels

print(converged_at)   # labels first stopped changing (-1 = never)
print(labels)         # cluster index of each point
print(C)              # final centroid coordinates
