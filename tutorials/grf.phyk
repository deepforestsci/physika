# GRF, create gaussian random field samples
class GRF(dx: ℝ, l: ℝ, m: ℕ):
    def rbf_kernel() -> ℝ[m, m]:
        K: ℝ[m, m] = for i:ℕ(this.m) -> for j:ℕ(this.m) -> exp(-((i * this.dx) - (j * this.dx))**2 / (2.0 * this.l**2))
        for i:ℕ(this.m):
            K[i, i] = K[i, i] + 0.0001
        return K
    def cholesky(K: ℝ[m, m]): ℝ[m, m]:
        L: ℝ[m, m] = zeros(m, m)
        for j:ℕ(this.m):
            diag: ℝ = K[j, j]
            for q:ℕ(j):
                diag = diag - L[j, q]**2
            L[j, j] = sqrt(diag)
            for i:ℕ(j + 1, this.m):
                acc: ℝ = K[i, j]
                for q:ℕ(j):
                    acc = acc - L[i, q] * L[j, q]
                L[i, j] = acc / L[j, j]
        return L
    def sample(Zs: ℝ[nu, m], nu: ℝ): ℝ[nu, m]:
        K: ℝ[m, m] = this.rbf_kernel()
        L: ℝ[m, m] = this.cholesky(K)
        us: ℝ[nu, m] = zeros(nu, m)
        for a:ℕ(nu):
            u: ℝ[m] = L @ Zs[a]
            us[a, :] = u
        return us


physika.seed(0)
m_demo: ℕ = 50
dx_demo: ℝ = 1.0 / (m_demo - 1)
l_demo: ℝ = 0.2
nu_demo: ℝ = 3

Zs_demo: ℝ[nu_demo, m_demo] = for i:ℕ(nu_demo) -> ε: ℝ[m_demo] ~ Normal(0.0, 1.0, m_demo)

grf_demo: GRF = GRF(dx_demo, l_demo, m_demo)
samples: ℝ[nu_demo, m_demo] = grf_demo.sample(Zs_demo, nu_demo)

print(samples[0, 0])
print(samples[0, 25])
print(samples[1, 25])
