nB: N = 1
B: N = 1
train_X: ℝ[nB, B, 1, 28, 28]  = rand_5d_array(1, 1, 1, 28, 28, 0.1)
train_y: ℝ[nB, B] = rand_2d_array(1, 10, 0.1)
test_X: ℝ[nB, B, 1, 28, 28] = rand_5d_array(1, 1, 1, 28, 28, 0.1)
test_y: ℝ[nB, B] = rand_2d_array(1, 10, 0.1)

# ----------------------------------------------


epochs: ℕ = 1
lr: ℝ = 0.1


train_loss: ℝ = model.train(train_X, train_y, epochs, lr)
print(train_loss)

#test_loss: ℝ = model.evaluate(test_X, test_y)
accuracy: ℝ = model.evaluate(train_X, train_y)
print(accuracy)
