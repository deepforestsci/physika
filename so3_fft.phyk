
from wigner_d import wigner_D, change_basis_real_to_complex
from S3 import quadrature_weights

def setup_so3_fft(b: N, nl: N, weighted: N): ℝ[2*b, nspec]:
    betas = (arange(0, 2*b) + 0.5) / (2*b) * 3.141592653589793
    w = quadrature_weights(b)
    nspec = 0
    for l:N(nl):
        nspec += (2*l + 1) * (2*l + 1)
    dss: ℝ[2*b, nspec] = zeros(2*b, nspec)
    for j:N(2*b):
        beta = betas[j:j+1]
        start = 0
        for l:N(nl):
            L = 2*l + 1
            D = wigner_D(l, [0.0], beta, [0.0])
            Q = change_basis_real_to_complex(l)
            D_complex = Q @ to_complex(D[0]) @ conj(Qᵀ)
            if weighted == 1:
                scale = w[j]
            else:
                scale = L
            dss[j, start:start+L*L] = view(
                resolve_conj(conj(D_complex)),
                L*L
            ) * scale
            start += L*L
    return dss


def sso3_rifft(x: ℝ[nspec, B, 2], for_grad: N, b_out: N): R[B, m, m, m, m]:
    zero: N = 0
    nspec, B, C = size(x)
    b_in = round((3.0 / 4.0 * nspec) ** (1.0 / 3.0))
    wigner = setup_so3_fft(b_out, b_in, for_grad)
    output: ℝ[B, 2*b_out, 2*b_out, 2*b_out, 2] = zeros(
        B, 2*b_out, 2*b_out, 2*b_out, 2
    )
    for l:N(min(b_in, b_out)):
        L = 2*l + 1
        start = l * (4*l*l - 1) / 3
        stop = start + L*L
        Fx = view(x[start:stop], L, L, B, 2)
        Fy = view(wigner[:, start:stop], 2*b_out, L, L)
        out = einsum("mnzc,bmn->zbmnc", Fx, Fy)
        l1 = min(l, b_out - 1)
        output[:, :, :l1+1, :l1+1, :] += out[:, :, l:l+l1+1, l:l+l1+1, :]
        if l > zero:
            output[:, :, -l1:, :l1+1, :] += out[:, :, l-l1:l, l:l+l1+1, :]
            output[:, :, :l1+1, -l1:, :] += out[:, :, l:l+l1+1, l-l1:l, :]
            output[:, :, -l1:, -l1:, :] += out[:, :, l-l1:l, l-l1:l, :]
    output = view_as_real(ifftn(view_as_complex(output),2, 3)) * (2*b_out)**2
    output = output[:, :, :, :, 0]
    return view(output, B, 2*b_out, 2*b_out, 2*b_out)



def so3_rifft(x: ℝ[nspec, B, O, 2],for_grad: N,b_out: N): ℝ[B, O, 2*b_out, 2*b_out, 2*b_out]:
    zero: N = 0
    nspec, B, O, _ = size(x)
    b_in = round((3.0 / 4.0 * nspec) ** (1.0 / 3.0))
    wigner = setup_so3_fft(b_out, b_in, for_grad)
    output: ℝ[B, O, 2*b_out, 2*b_out, 2*b_out, 2] = zeros(
        B, O, 2*b_out, 2*b_out, 2*b_out, 2
    )
    for l:N(min(b_in, b_out)):
        L = 2*l + 1
        start = l * (4*l*l - 1) / 3
        stop = start + L*L
        Fx = view(x[start:stop], L, L, B, O, 2)
        Fy = view(wigner[:, start:stop], 2*b_out, L, L)
        out = einsum("mnboc,zmn->bozmnc", Fx, Fy)
        l1 = min(l, b_out - 1)
        output[:, :, :, :l1+1, :l1+1, :] += out[:, :, :, l:l+l1+1, l:l+l1+1, :]
        if l > zero:
            output[:, :, :, -l1:, :l1+1, :] += out[:, :, :, l-l1:l, l:l+l1+1, :]
            output[:, :, :, :l1+1, -l1:, :] += out[:, :, :, l:l+l1+1, l-l1:l, :]
            output[:, :, :, -l1:, -l1:, :] += out[:, :, :, l-l1:l, l-l1:l, :]
    output = view_as_real(ifftn(view_as_complex(output), 3, 4)) * (2*b_out)**2
    output = output[:, :, :, :, :, 0]
    return output

