
from wigner_d import wigner_D
from S3 import quadrature_weights



def setup_wigner(b: N, nl: N, weighted: N): R[m, n]:
    betas = (arange(0, 2*b) + 0.5) / (2*b) * 3.141592653589793
    w = quadrature_weights(b) * (2*b)
    dss: ℝ[2*b, nl*nl] = zeros(2*b, nl*nl)
    for j:N(2*b):
        beta = betas[j:j+1]
        for l:N(nl):
            D = wigner_D(l, [0.0], beta, [0.0])
            Q = change_basis_real_to_complex(l)
            D_complex = Q @ to_complex(D[0]) @ conj(Qᵀ)
            if weighted == 1:
                scale = w[j]
            else:
                scale = 2*l + 1
            for i:N(2*l+1):
                dss[j, l*l + i] = D_complex[i, l] * scale
    return dss


def s2_ffft(x: R[B, b, a, c], b_out: N): R[m, n, o, p]:
    zero: N = 0
    B, b, a, c = size(x)
    b_in = b / 2
    x = view(x, -1, 2*b_in, 2*b_in, 2)
    n_spec = b_out ** 2
    nbatch = B
    wigner = setup_wigner(b_in, b_out, 1)
    wigner = view(wigner, 2*b_in, -1)
    x = view_as_real(fft(view_as_complex(x)))
    output: R[n_spec, nbatch, 2] = zeros(n_spec, nbatch, 2)
    for l:N(b_out):
        if l>zero:
            xx = concat(x[:, :, -l:], x[:, :, :l+1], 2)
        else:
            xx = x[:, :, :1]
        start = l*l
        end = start + 2*l + 1
        output[start:end] = einsum("bm,zbmc->mzc", wigner[:, start:end], xx)
    return output



def s2_fft(x: R[B, b, a, c], b_out: N): R[m, n, o, p]:
    zero: N = 0
    B, I, H, W = size(x)
    b_in = H / 2
    x = view(x, B*I, 2*b_in, 2*b_in)
    wigner = setup_wigner(b_in, b_out, 1)
    wigner = view(wigner, 2*b_in, -1)
    x = view_as_real(fft(x))
    n_spec = b_out*b_out
    output: ℝ[n_spec, B*I, 2] = zeros(n_spec, B*I, 2)
    for l:N(b_out):
        if l > zero:
            xx = concat(x[:, :, -l:], x[:, :, :l+1], 2)
        else:
            xx = x[:, :, :1]
        start = l*l
        end = start + 2*l + 1
        output[start:end] = einsum(
            "bm,zbmc->mzc",
            wigner[:, start:end],
            xx
        )
    return view(output, n_spec, B, I, 2)

